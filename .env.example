# Names only. On the droplet these live in Iron-Fleet's deploy/droplet/.env.
# Never commit values: this repository is public.

# Argon2id PHC string, from:
#   docker compose run --rm jarvis-web hash-password
JARVIS_WEB_PASSWORD_HASH=
# This site's own Opus Systems OS API key (osk_…), minted on the droplet:
#   docker compose exec -T api opus-api keys create --name web --scopes …
WEB_API_KEY=
# The API on the compose network.
OPUS_API_URL=http://api:8100
# Optional
# SESSION_HOURS=12
# PORT=8200
# DATABASE_PATH=/data/jarvis-web.db
# STATIC_DIR=/app/web
